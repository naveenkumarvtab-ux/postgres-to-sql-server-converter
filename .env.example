# Public URL of the separately deployed Express API. Do not include a trailing slash.
VITE_API_BASE_URL=https://your-postgres-converter-api.onrender.com

# Supabase configuration used by the browser client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend-only values: set these on the Express API service, never in this frontend file.
# VTAB_SSO_SECRET=your-vtab-sso-secret
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
